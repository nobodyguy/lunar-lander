{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "request": "launch",
      "command": "npm start",
      "type": "node-terminal"
    },
    {
      "name": "Launch",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:8000",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Run",
      "configurations": ["Server", "Launch"],
      "stopAll": true
    }
  ]
}
